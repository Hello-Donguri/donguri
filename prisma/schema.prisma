generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  // Load `include`d relations with one LATERAL-join query instead of one
  // query per relation level. The DB is a remote pooler (~285ms RTT), so
  // e.g. getReviewQueue went from 4 sequential round trips to 1.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                     String                  @id @db.Uuid
  email                  String
  fullName               String?                 @map("full_name")
  firstName              String?                 @map("first_name")
  lastName               String?                 @map("last_name")
  // Public handle for the leaderboards — set once, never editable (see
  // section 39 of supabase/schema.sql). Null until the user picks one.
  username               String?                 @unique
  // Keeps /dashboard/users/<username> to its owner — see section 43 of
  // supabase/schema.sql.
  profileHidden          Boolean                 @default(false) @map("profile_hidden")
  // A visitor learning without an account (a Supabase anonymous user) —
  // see section 50 of supabase/schema.sql and lib/access.ts.
  isGuest                Boolean                 @default(false) @map("is_guest")
  // 'en', 'ja' or 'other'; null for accounts from before it was asked.
  // See section 48 of supabase/schema.sql.
  nativeLanguage         String?                 @map("native_language")
  // Why they're learning (see LEARNING_REASONS in lib/definitions.ts); null
  // for accounts from before it was asked. See section 54 of
  // supabase/schema.sql.
  learningReason         String?                 @map("learning_reason")
  // When they finished or dismissed the course page's welcome tour; null
  // until then. See section 55 of supabase/schema.sql.
  tourSeenAt             DateTime?               @map("tour_seen_at") @db.Timestamptz(6)
  // The "regain your crown" email (lib/weekly-crown.ts) — on unless turned
  // off in account settings; at most one a day.
  emailOvertaken         Boolean                 @default(true) @map("email_overtaken")
  overtakenEmailedAt     DateTime?               @map("overtaken_emailed_at") @db.Timestamptz(6)
  role                  String                  @default("user")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Total experience points — incremented only by the vocab quiz actions in
  // lib/actions/vocab.ts (+1 per correct answer, +5 bonus for a perfect
  // quiz, plus a half-point-per-day streak bonus), never set directly from
  // a user-editable form field. A float (not Int) because the streak bonus
  // is awarded in 0.5 increments.
  xp                     Float                   @default(0)
  // Free-form settings blob the user can view/edit as raw JSON from their
  // profile page — no fixed shape yet, deliberately generic.
  donguriConfig          Json?                   @map("donguri_config")
  enrollments            CourseEnrollment[]
  addedByOthers          Friendship[]            @relation("FriendshipsAsFriend")
  friendsAdded           Friendship[]            @relation("FriendshipsAsUser")
  deckActivations        UserDeckActivation[]
  wordProgress           UserWordProgress[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  xpEvents               XpEvent[]
  reviewEvents           ReviewEvent[]
  subscription           Subscription?
  badges                 UserBadge[]
  weeklyLeader           WeeklyLeader[]

  @@map("profiles")
}

// One-directional: `userId` added `friendId` to their own friends list, no
// acceptance step needed — just enough for a personal "friends leaderboard"
// alongside the global top-10.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Friendship {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  friendId  String   @map("friend_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  friend    Profile  @relation("FriendshipsAsFriend", fields: [friendId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Profile  @relation("FriendshipsAsUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, friendId])
  @@map("friendships")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Course {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String                  @unique
  title                  String
  targetLanguage         String                  @map("target_language")
  sourceLanguage         String                  @map("source_language")
  description            String?
  position               Int
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  active                 Boolean                 @default(true)
  // The course page's greeting in the target language, and the line under
  // it in the audience's — see section 49 of supabase/schema.sql.
  greetings              Json?
  motivations            Json?
  enrollments            CourseEnrollment[]
  languageDecks          LanguageDeck[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  badges                 Badge[]

  @@map("courses")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CourseEnrollment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  courseId            String    @map("course_id") @db.Uuid
  enrolledAt          DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  currentStreak       Int       @default(0) @map("current_streak")
  longestStreak       Int       @default(0) @map("longest_streak")
  lastActivityDate    DateTime? @map("last_activity_date") @db.Date
  // The last UTC date this course's streak XP bonus was awarded — so
  // completing a second quiz on the same day doesn't award it again.
  lastStreakBonusDate DateTime? @map("last_streak_bonus_date") @db.Date
  // Set when the learner leaves the course; null while enrolled. Leaving
  // keeps the row and all progress — see section 45 of supabase/schema.sql.
  unenrolledAt        DateTime? @map("unenrolled_at") @db.Timestamptz(6)
  // 'beginner', 'intermediate' or 'advanced' — picked on enrolling; sets
  // how Charles Duck talks to them. See section 52 of supabase/schema.sql.
  level               String    @default("beginner")
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile             Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model LanguageDeck {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  subheading    String?
  description   String?
  coverImageKey String?              @map("cover_image_key")
  bgColor       String?              @map("bg_color")
  primaryColor  String?              @map("primary_color")
  position      Int
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  courseId      String               @map("course_id") @db.Uuid
  active        Boolean              @default(true)
  // Short, free-text labels shown as badges on deck cards — a per-deck
  // list, not a shared/reusable taxonomy (see WordCategory for that shape).
  tags          String[]             @default([])
  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activations   UserDeckActivation[]
  words         Word[]

  @@unique([courseId, position])
  @@map("language_decks")
}

// A user's personal "active decks" list within a course — which decks
// currently feed the Learn/Test pool (see getActiveDeckIds/
// getLearnQueueForCourse in lib/dal.ts). A deck can hold vocab words,
// grammar points, or a mixture (see `Word.path`) — activation is purely
// per-deck, not per content type. `active` is a real column (not row
// presence/absence) so "explicitly deactivated" stays distinguishable from
// "never touched" even after every deck is turned off — getActiveDeckIds
// needs that distinction to only lazily auto-activate the first deck once,
// on a brand-new enrollment, never re-activating something the user
// deliberately turned off.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserDeckActivation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  languageDeckId String       @map("language_deck_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  active         Boolean      @default(true)
  languageDeck   LanguageDeck @relation(fields: [languageDeckId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile        Profile      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, languageDeckId])
  @@map("user_deck_activations")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Word {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  languageDeckId   String                @map("language_deck_id") @db.Uuid
  // 'vocab' or 'grammar' — a deck's own content mix, not its identity: one
  // deck can hold both. Used to be `LanguageDeck.path` (one type per deck,
  // a "grammar sibling" deck paired by shared position); moved here so a
  // single deck can mix vocab words and grammar points. Defaults to
  // 'vocab' since that's the only content that existed before this column
  // did. See the check constraint in supabase/schema.sql.
  path             String                @default("vocab")
  term             String
  translation      String
  exampleSentence  String?               @map("example_sentence")
  position         Int
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  romanization     String?
  active           Boolean               @default(true)
  imageKey         String?               @map("image_key")
  explanation      String?
  explanationJa    String?               @map("explanation_ja")
  categoryId       String?               @map("category_id") @db.Uuid
  wordType         String?               @map("word_type")
  progress         UserWordProgress[]
  alternateAnswers WordAlternateAnswer[]
  examples         WordExample[]
  forms            WordForm[]
  quizQuestions    WordQuizQuestion[]
  reviewEvents     ReviewEvent[]
  category         WordCategory?         @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  languageDeck     LanguageDeck          @relation(fields: [languageDeckId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([languageDeckId, position])
  @@map("words")
}

// Extra accepted spellings/answers for a word's typed-answer questions (see
// matchesTypedAnswer in lib/actions/vocab.ts) — e.g. "3" or "三" alongside
// "Three" — checked in addition to the word's own term/translation/
// romanization, regardless of which side (term or translation) the learner
// is currently typing.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordAlternateAnswer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId    String   @map("word_id") @db.Uuid
  value     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_alternate_answers")
}

// Hand-authored multiple-choice questions an admin adds for a specific word.
// Editable from the admin quiz-questions page, but not currently mixed into
// the auto-generated quiz/review question builders in lib/dal.ts.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordQuizQuestion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId       String   @map("word_id") @db.Uuid
  prompt       String
  promptJa     String?  @map("prompt_ja")
  options      String[]
  correctIndex Int      @map("correct_index")
  position     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_quiz_questions")
}

// A word's inflected/conjugated forms (e.g. go/goes/went/gone/going). Generic
// on purpose — labels are free text set by the admin — so it also covers
// non-verb inflections (noun plurals, adjective comparatives) without a
// schema change.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordForm {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId    String        @map("word_id") @db.Uuid
  labelEn   String        @map("label_en")
  labelJa   String        @map("label_ja")
  value     String
  position  Int
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  examples  WordExample[]
  word      Word          @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_forms")
}

// Example sentence pairs for a word. `formId` optionally ties an example to
// the specific form it demonstrates (used to build "type the form" quiz
// questions from the Japanese side); null means a general example not tied
// to one form.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordExample {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId       String    @map("word_id") @db.Uuid
  formId       String?   @map("form_id") @db.Uuid
  en           String
  ja           String
  // Pronunciation aid for the non-English sentence (e.g. Jyutping for a
  // Cantonese example) — optional, like `Word.romanization`.
  romanization String?
  // The part of each sentence that is the word itself, when an admin has
  // marked it (bold in the import spreadsheet, or typed in the word
  // editor). Takes priority over the automatic highlighting, for sentences
  // that use a different form than the stored term/translation. Null means
  // "not marked" — fall back to the automatic match.
  enHighlight  String?   @map("en_highlight")
  jaHighlight  String?   @map("ja_highlight")
  position     Int
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  form         WordForm? @relation(fields: [formId], references: [id], onUpdate: NoAction)
  word         Word      @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, position])
  @@map("word_examples")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserWordProgress {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  wordId         String    @map("word_id") @db.Uuid
  status         String    @default("learning")
  // 1-8, see the STAGES table in lib/srs.ts — replaces the old 1-5 "box".
  // Stage 8 is "Mastered" (status flips to 'known', nextReviewAt cleared).
  stage          Int       @default(1)
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  skipped        Boolean   @default(false)
  introducedAt   DateTime  @default(now()) @map("introduced_at") @db.Timestamptz(6)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  // When this word is next due in the review queue — set 15 minutes out the
  // moment it's learnt (whether or not its post-learn quiz is ever taken),
  // and null once it reaches stage 8 (mastered, no more reviews).
  nextReviewAt   DateTime? @map("next_review_at") @db.Timestamptz(6)
  // When the learner flagged this word to revisit its lesson (see section
  // 53 of supabase/schema.sql); null when it isn't flagged.
  flaggedAt      DateTime? @map("flagged_at") @db.Timestamptz(6)
  profile        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  word           Word      @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, wordId])
  @@map("user_word_progress")
}

// A cross-deck topical tag with its own admin-managed color — distinct from
// a "category" elsewhere in this app, which is the admin UI's name for a
// `LanguageDeck` (deck). E.g. the "Colours" word-category can appear on words
// inside a "TOEIC Basic" deck.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WordCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  words     Word[]

  @@map("word_categories")
}

// One row per attempt of the (currently stub) daily challenge — capped at 3
// per user per course per UTC day, enforced in the app layer (see
// completeDailyChallenge in lib/actions/daily-challenge.ts) rather than a DB
// constraint, since the cap is a product rule that may change.
// `challengeDate` is stored explicitly (rather than derived from
// `createdAt`) so "how many today" is a plain equality filter regardless of
// query-time timezone, matching `lastActivityDate` on `CourseEnrollment`.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DailyChallengeAttempt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  challengeDate    DateTime @map("challenge_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  xpEarned         Int      @default(0) @map("xp_earned")
  targetTerms      String[] @default([]) @map("target_terms")
  message          String?
  grammarScore     Int?     @map("grammar_score") @db.SmallInt
  naturalnessScore Int?     @map("naturalness_score") @db.SmallInt
  relevanceScore   Int?     @map("relevance_score") @db.SmallInt
  complexityScore  Int?     @map("complexity_score") @db.SmallInt
  // { overall, tips, betterVersion } — see ChallengeSummary in
  // lib/actions/daily-challenge.ts.
  summary          Json?
  // Skipped as too hard: uses up the attempt, but earns nothing and isn't
  // counted as doing a challenge (see section 42 of supabase/schema.sql).
  skipped          Boolean  @default(false)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, courseId, challengeDate], map: "daily_challenge_attempts_user_course_date_idx")
  @@map("daily_challenge_attempts")
}

// One row per XP award, alongside the running total on `Profile.xp` — so
// "XP earned this week" can be summed over a date range (see
// getWeeklyStats/getLeaderboards in lib/dal.ts). Not backfilled: awards
// made before the table existed only live in `Profile.xp`.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model XpEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Float
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt, userId], map: "xp_events_created_at_user_idx")
  @@map("xp_events")
}

// One row per answer in the scheduled review queue — `lastSeenAt` on
// UserWordProgress only keeps the latest, so this is what per-day review
// counts, review accuracy and the streak's review days come from (see
// getDailyActivityCounts/getWeeklyStats/getGlobalStreak in lib/dal.ts).
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ReviewEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  wordId    String   @map("word_id") @db.Uuid
  correct   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "review_events_user_created_at_idx")
  @@map("review_events")
}

// A user's Stripe customer and a synced copy of their subscription — see
// section 37 of supabase/schema.sql and syncStripeCustomer in
// lib/billing.ts. Only the server writes it (RLS: owner read-only).
model Subscription {
  userId               String    @id @map("user_id") @db.Uuid
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  status               String?
  priceId              String?   @map("price_id")
  trialEnd             DateTime? @map("trial_end") @db.Timestamptz(6)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  trialUsed            Boolean   @default(false) @map("trial_used")
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  profile              Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("subscriptions")
}

// An admin-made badge a learner earns by reaching a milestone — `metric` ≥
// `threshold` (see BADGE_METRICS in lib/badge-metrics.ts and lib/badges.ts).
// `awardExisting` is set once, at creation: true gives it to everyone who
// already qualifies, false records them as skipped (see UserBadge).
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Badge {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  imageKey      String      @map("image_key")
  metric        String
  threshold     Int
  active        Boolean     @default(true)
  awardExisting Boolean     @default(false) @map("award_existing")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  // Null: every course. See section 41 of supabase/schema.sql.
  courseId      String?     @map("course_id") @db.Uuid
  // Null: all time; "day" or "week": within one UTC day / week.
  timescale     String?
  // Extra XP for earning it. See section 46 of supabase/schema.sql.
  xpReward      Int         @default(0) @map("xp_reward")
  course        Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userBadges    UserBadge[]

  @@index([courseId], map: "badges_course_id_idx")
  @@map("badges")
}

// One learner's badge: `status` "awarded", or "skipped" when they already
// qualified as a badge was made without `awardExisting` (they never get
// it). `seenAt` is set once its celebration has been shown.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserBadge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  badgeId   String    @map("badge_id") @db.Uuid
  status    String    @default("awarded")
  awardedAt DateTime  @default(now()) @map("awarded_at") @db.Timestamptz(6)
  seenAt    DateTime? @map("seen_at") @db.Timestamptz(6)
  // The badge's XP reward when it was awarded (0 when skipped).
  xpAwarded Int       @default(0) @map("xp_awarded")
  badge     Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, badgeId], map: "user_badges_user_badge_key")
  @@map("user_badges")
}

// Who was last #1 on the weekly XP leaderboard — one row, so a change of
// leader can be spotted after each XP award (see lib/weekly-crown.ts).
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WeeklyLeader {
  id        Int      @id @default(1)
  userId    String?  @map("user_id") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  profile   Profile? @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("weekly_leader")
}
